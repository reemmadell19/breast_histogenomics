{
  "model_name": "h-optimus",
  "mil_architecture": "acmil",
  "optimizer_type": "adamw",
  "learning_rate": 3e-05,
  "weight_decay": 0.005,
  "num_epochs": 50,
  "batch_size": 1,
  "hidden_dim": 48,
  "attention_hidden_dim": 128,
  "dropout": 0.35,
  "use_class_balancing": true,
  "use_class_weights": false,
  "use_gradient_clip": true,
  "gradient_clip_val": 1.0,
  "use_scheduler": true,
  "scheduler_type": "cosine",
  "n_folds": 5,
  "random_seed": 42,
  "loss_function": "cross_entropy",
  "alpha": [
    0.25,
    0.75
  ],
  "n_clusters": 8,
  "n_branches": 1,
  "n_masked_patch": 3,
  "mask_ratio": 0.5,
  "momentum": 0.999,
  "temperature": 1.0,
  "lambda_cluster": 1.0,
  "lambda_consistency": 0.1
}