{
  "model_name": "h-optimus",
  "mil_architecture": "acmil",
  "optimizer_type": "adamw",
  "learning_rate": 2e-05,
  "weight_decay": 0.005,
  "num_epochs": 50,
  "batch_size": 4,
  "hidden_dim": 32,
  "attention_hidden_dim": 64,
  "n_branches": 3,
  "n_masked_patch": 5,
  "mask_ratio": 0.4,
  "dropout": 0.4,
  "use_class_balancing": true,
  "use_class_weights": false,
  "use_gradient_clip": true,
  "gradient_clip_val": 0.5,
  "use_scheduler": false,
  "scheduler_type": "cosine",
  "n_folds": 5,
  "random_seed": 42
}