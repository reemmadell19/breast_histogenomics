{
  "strategy": "focal_loss",
  "strategy_name": "Focal Loss",
  "strategy_config": {
    "name": "Focal Loss",
    "use_class_weights": false,
    "use_focal_loss": true,
    "use_balanced_sampling": false,
    "focal_gamma": 2.0,
    "focal_alpha": [
      0.25,
      0.75
    ],
    "description": "Focal loss to focus on hard examples"
  },
  "model": "resnet18",
  "mil_architecture": "mean",
  "learning_rate": 0.0001,
  "weight_decay": 0.001,
  "num_epochs": 30,
  "batch_size": 4,
  "hidden_dim": 128,
  "dropout": 0.25,
  "n_folds": 5,
  "random_seed": 42
}